// Schema de base de dades per a l'app de gestió de la Federació Catalana d'AVPC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon dona una URL amb "pooler" (PgBouncer) pensada per a l'aplicació en
  // marxa; "prisma migrate deploy" necessita agafar un advisory lock de
  // sessió que el pooler no suporta bé i acaba fent timeout. DIRECT_URL ha
  // de ser la mateixa connexió de Neon però SENSE "-pooler" al host.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  FEDERACIO
  AGRUPACIO
  VOLUNTARI
  ADMIN_AVPC
}

enum Disponibilitat {
  PRESENCIAL
  IMMEDIATA
  DIFERIDA
  NO_DISPONIBLE
}

enum PropietatVehicle {
  PROPI
  RENTING
  CEDIT
}

enum EstatMaterial {
  OPERATIU
  MANTENIMENT
  BAIXA
}

enum TipusDocument {
  ESTATUTS
  ACTA
  ALTRES
}

model Usuari {
  id          String   @id @default(uuid())
  nom         String
  usuari      String   @unique
  contrasenya String
  rol         Rol
  actiu       Boolean  @default(true)
  creatEl     DateTime @default(now())

  agrupacio   Agrupacio? @relation(fields: [agrupacioId], references: [id])
  agrupacioId String?

  subscripcionsPush  SubscripcioPush[]
  documentsPujats    Document[]
  recursosFormacio   RecursFormacio[]
  voluntariPerfil    Voluntari?
  serveisCreats      Servei[]
  registresAuditoria RegistreAuditoria[]
}

// Registre de qui crea, edita o elimina fitxes amb dades personals
// sensibles (de moment, voluntaris), per poder respondre "qui ha tocat
// aquesta dada i quan" (traçabilitat exigida per protecció de dades).
// entitatId NO té relació de clau forana perquè el registre ha de
// sobreviure encara que el registre original s'elimini.
model RegistreAuditoria {
  id          String   @id @default(uuid())
  usuari      Usuari   @relation(fields: [usuariId], references: [id])
  usuariId    String
  accio       String
  entitat     String
  entitatId   String
  agrupacioId String?
  detall      String?
  creatEl     DateTime @default(now())
}

// Una agrupació/associació federada dins la Federació Catalana d'AVPC.
model Agrupacio {
  id           String    @id @default(uuid())
  nom          String
  provincia    String?
  municipi     String?
  comarca      String?
  adreca       String?
  telefon      String?
  email        String?
  president    String?
  dataFundacio DateTime?
  latitud      Float?
  longitud     Float?
  actiu        Boolean   @default(true)
  creatEl      DateTime  @default(now())

  usuaris            Usuari[]
  vehicles           Vehicle[]
  materials          Material[]
  documents          Document[]
  avisos             Avis[]
  voluntaris         Voluntari[]
  serveis            Servei[]
  proveidors         Proveidor[]
  articlesEquipament ArticleEquipament[]
  tipusServei        TipusServei[]
  categoriesServei   CategoriaServei[]
  localitatsServei   LocalitatServei[]
  sollicitantsServei SollicitantServei[]
  nomsEquipament     NomEquipament[]
}

// Proveïdors de cada associació (tallers, subministradors de combustible,
// material, assegurances...), amb una persona de contacte de referència.
model Proveidor {
  id          String    @id @default(uuid())
  agrupacio   Agrupacio @relation(fields: [agrupacioId], references: [id])
  agrupacioId String
  nom         String
  categoria   String?
  contacte    String?
  telefon     String?
  email       String?
  adreca      String?
  notes       String?
  actiu       Boolean   @default(true)
  creatEl     DateTime  @default(now())
}

// Fitxa d'un voluntari (roster) d'una associació. Opcionalment pot tenir un
// compte d'accés propi (usuariId) perquè es connecti des del seu mòbil per
// confirmar assistència als serveis; si no en té, l'associació el gestiona
// tot des del seu propi compte.
model Voluntari {
  id                  String          @id @default(uuid())
  agrupacio           Agrupacio       @relation(fields: [agrupacioId], references: [id])
  agrupacioId         String
  nom                 String
  cognoms             String
  telefon             String?
  dni                 String?
  genere              String?
  dataNaixement       DateTime?
  provincia           String?
  localitat           String?
  adreca              String?
  codiPostal          String?
  dataIngres          DateTime?
  dataBaixa           DateTime?
  numeroIdentificacio String?
  indicatiu           String?
  carrec              String?
  altresEmails        String?
  altresAgrupacions   String?
  disponibilitat      Disponibilitat  @default(NO_DISPONIBLE)
  actiu               Boolean         @default(true)
  // Deixa constància que l'associació ha informat el voluntari i té el
  // seu consentiment per tractar les seves dades (RGPD/LOPDGDD).
  consentimentDades   Boolean         @default(false)
  creatEl             DateTime        @default(now())

  usuari              Usuari?         @relation(fields: [usuariId], references: [id])
  usuariId            String?         @unique

  assistencies        AssistenciaServei[]
  equipamentAssignat  AssignacioEquipament[]
}

enum TipusEquipament {
  ROBA
  EPI
}

// Catàleg de noms d'article (p.ex. "Casc", "Jaqueta impermeable") pel
// desplegable del formulari d'estoc de roba/EPI. Mateix patró que els
// catàlegs de servei: agrupacioId nul = comú (creat per la federació,
// només ella el pot editar/eliminar); si en té un, és propi d'aquella
// associació.
model NomEquipament {
  id          String          @id @default(uuid())
  tipus       TipusEquipament
  nom         String
  agrupacio   Agrupacio?      @relation(fields: [agrupacioId], references: [id])
  agrupacioId String?
  creatEl     DateTime        @default(now())

  @@unique([tipus, nom, agrupacioId])
}

// Estoc de roba i EPI (equip de protecció individual) de cada associació.
// estocTotal és el total d'unitats que té l'associació; les que estan
// assignades a un voluntari (sense retornar) es resten per saber les lliures.
model ArticleEquipament {
  id          String          @id @default(uuid())
  agrupacio   Agrupacio       @relation(fields: [agrupacioId], references: [id])
  agrupacioId String
  tipus       TipusEquipament
  nom         String
  talla       String?
  estocTotal  Int             @default(0)
  notes       String?
  creatEl     DateTime        @default(now())

  assignacions AssignacioEquipament[]
}

// Registre de quina roba/EPI té assignat cada voluntari. dataRetorn nul vol
// dir que encara ho té; un cop retornat es marca la data i torna a l'estoc lliure.
model AssignacioEquipament {
  id             String            @id @default(uuid())
  article        ArticleEquipament @relation(fields: [articleId], references: [id])
  articleId      String
  voluntari      Voluntari         @relation(fields: [voluntariId], references: [id])
  voluntariId    String
  quantitat      Int               @default(1)
  dataAssignacio DateTime          @default(now())
  dataRetorn     DateTime?
  notes          String?
  creatEl        DateTime          @default(now())
}

// Catàlegs de tipus, categoria, localitat i sol·licitant que es fan servir
// als desplegables del formulari de serveis. agrupacioId nul vol dir que
// l'ha creat la federació (comú a tothom, només la federació el pot editar
// o eliminar); si en té un, és propi d'aquella associació i només ella
// (o la federació) el pot editar o eliminar.
model TipusServei {
  id          String     @id @default(uuid())
  nom         String
  agrupacio   Agrupacio? @relation(fields: [agrupacioId], references: [id])
  agrupacioId String?
  creatEl     DateTime   @default(now())

  @@unique([nom, agrupacioId])
}

model CategoriaServei {
  id          String     @id @default(uuid())
  nom         String
  agrupacio   Agrupacio? @relation(fields: [agrupacioId], references: [id])
  agrupacioId String?
  creatEl     DateTime   @default(now())

  @@unique([nom, agrupacioId])
}

model LocalitatServei {
  id          String     @id @default(uuid())
  nom         String
  agrupacio   Agrupacio? @relation(fields: [agrupacioId], references: [id])
  agrupacioId String?
  creatEl     DateTime   @default(now())

  @@unique([nom, agrupacioId])
}

model SollicitantServei {
  id          String     @id @default(uuid())
  nom         String
  agrupacio   Agrupacio? @relation(fields: [agrupacioId], references: [id])
  agrupacioId String?
  creatEl     DateTime   @default(now())

  @@unique([nom, agrupacioId])
}

// Un servei (intervenció, assemblea, acte...) d'una associació. Es convoca
// als voluntaris segons la seva disponibilitat (o a tots) i ells confirmen
// assistència des del seu compte; l'associació pot marcar hores reals fetes
// per calcular estadístiques i generar l'informe del servei.
model Servei {
  id                     String    @id @default(uuid())
  agrupacio              Agrupacio @relation(fields: [agrupacioId], references: [id])
  agrupacioId            String
  titol                  String
  numeracio              String?
  maxAssistents          Int?
  collaboracioEmergencies Boolean  @default(false)
  dataInici              DateTime
  dataFi                 DateTime
  limitInscripcio        DateTime?
  horaBase               DateTime?
  horaSortida            DateTime?
  tipus                  String?
  categoria              String?
  localitat              String?
  sollicitant            String?
  latitud                Float?
  longitud               Float?
  adreca                 String?
  descripcio             String?
  destinataris           String?   // "TOTS" o llista separada per comes: PRESENCIAL,IMMEDIATA,DIFERIDA
  arxivat                Boolean   @default(false)
  creatPer               Usuari    @relation(fields: [creatPerId], references: [id])
  creatPerId             String
  creatEl                DateTime  @default(now())

  assistencies           AssistenciaServei[]
}

// Relació entre un servei i un voluntari: si ha confirmat assistència i,
// un cop fet el servei, les hores reals treballades (per als informes
// d'estadístiques i el control d'hores de servei).
model AssistenciaServei {
  id               String    @id @default(uuid())
  servei           Servei    @relation(fields: [serveiId], references: [id])
  serveiId         String
  voluntari        Voluntari @relation(fields: [voluntariId], references: [id])
  voluntariId      String
  confirmat        Boolean   @default(false)
  horaEntrada      DateTime?
  horaSortida      DateTime?
  horesRealitzades Float?
  notes            String?
  creatEl          DateTime  @default(now())

  @@unique([serveiId, voluntariId])
}

// Flota de vehicles de cada agrupació, amb la propera data de revisió
// (mateix control que fa servir AITASA per a la seva pròpia flota).
model Vehicle {
  id             String           @id @default(uuid())
  agrupacio      Agrupacio        @relation(fields: [agrupacioId], references: [id])
  agrupacioId    String
  matricula      String?          @unique
  tipus          String?
  marca          String?
  model          String?
  propietat      PropietatVehicle
  empresaRenting String?
  proximaRevisio DateTime?
  notes          String?
  creatEl        DateTime         @default(now())
}

// Material i equipament de cada agrupació. Es llista sencer a totes les
// agrupacions (només lectura fora de la pròpia) perquè en cas d'emergència
// es pugui saber ràpidament què hi ha disponible a prop.
model Material {
  id            String        @id @default(uuid())
  agrupacio     Agrupacio     @relation(fields: [agrupacioId], references: [id])
  agrupacioId   String
  nom           String
  quantitat     Int           @default(0)
  estat         EstatMaterial @default(OPERATIU)
  notes         String?
  creatEl       DateTime      @default(now())
  actualitzatEl DateTime      @updatedAt
}

// Estatuts, llibre d'actes i altra documentació oficial. Només la federació
// en puja; tothom els pot veure. agrupacioId nul vol dir que és un document
// comú de la federació; si en té un, és propi d'aquella associació.
// pendent=true vol dir que és una sol·licitud sense fitxer encara (la
// federació demana un document concret a una associació, que l'ha de pujar).
// El fitxer es guarda directament a la base de dades (no al disc del
// servidor) perquè sobrevisqui als redeploys d'un pla gratuït sense disc
// persistent.
model Document {
  id              String        @id @default(uuid())
  agrupacio       Agrupacio?    @relation(fields: [agrupacioId], references: [id])
  agrupacioId     String?
  tipus           TipusDocument
  titol           String
  dataDocument    DateTime?
  pendent         Boolean       @default(false)
  fitxerNom       String?
  fitxerContingut Bytes?
  fitxerMimeType  String?
  pujatPer        Usuari        @relation(fields: [pujatPerId], references: [id])
  pujatPerId      String
  creatEl         DateTime      @default(now())
}

// Biblioteca de recursos de formació: la federació hi penja PDFs o enllaços
// (p.ex. a un vídeo o document extern) perquè les associacions els consultin.
// No és un catàleg de cursos amb dates ni inscripcions, només material de
// consulta. Cal tenir com a mínim l'enllaç o el fitxer (poden coexistir).
model RecursFormacio {
  id              String   @id @default(uuid())
  titol           String
  url             String?
  fitxerNom       String?
  fitxerContingut Bytes?
  fitxerMimeType  String?
  pujatPer        Usuari   @relation(fields: [pujatPerId], references: [id])
  pujatPerId      String
  creatEl         DateTime @default(now())
}

// Comunicats amb notificació push. agrupacioId nul vol dir que és un avís
// de tota la federació; si té agrupació, només arriba als usuaris d'aquesta.
model Avis {
  id            String     @id @default(uuid())
  titol         String
  cos           String
  agrupacio     Agrupacio? @relation(fields: [agrupacioId], references: [id])
  agrupacioId   String?
  dataEnviament DateTime   @default(now())
  enviat        Boolean    @default(false)
  creatEl       DateTime   @default(now())
}

// Guarda la subscripció push del navegador de cada dispositiu de l'usuari,
// perquè el servidor pugui enviar-li notificacions encara que no tingui la web oberta.
model SubscripcioPush {
  id       String   @id @default(uuid())
  usuari   Usuari   @relation(fields: [usuariId], references: [id])
  usuariId String
  endpoint String   @unique
  p256dh   String
  auth     String
  creatEl  DateTime @default(now())
}

// Catàleg de províncies que la federació manté (afegir/editar/eliminar),
// perquè el desplegable de "crear usuari" sempre mostri opcions controlades.
model Provincia {
  id      String   @id @default(uuid())
  nom     String   @unique
  creatEl DateTime @default(now())
}

// Catàleg de tipus de vehicle (turisme, pickup, camió, remolc, tractor...)
// que la federació manté, perquè el desplegable de vehicles s'adapti a
// qualsevol tipus de vehicle que tinguin les associacions.
model TipusVehicle {
  id      String   @id @default(uuid())
  nom     String   @unique
  creatEl DateTime @default(now())
}

// Catàleg de noms de material (ràdio, motxilla, casc, armilla...) que la
// federació manté, perquè totes les associacions facin servir el mateix
// nom per al mateix tipus de material a l'inventari.
model TipusMaterial {
  id      String   @id @default(uuid())
  nom     String   @unique
  creatEl DateTime @default(now())
}
